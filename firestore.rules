rules_version = '2';

// 使用者資料（user/{uid}：設定 + 統計快照）僅限本人讀寫;
// 其餘路徑一律拒絕。Cloud Functions 走 Admin SDK 不受此規則限制。
service cloud.firestore {
  match /databases/{database}/documents {
    match /user/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // user/{uid}/lyrics/{trackId} 是後端歌詞任務（對時 / 產生）的投遞點，
      // client 只能讀；client 自己的歌詞備份走 user/{uid}/backupLyrics。
      match /lyrics/{trackId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // 其餘子集合（setting / playlist / monthlyStats / backupLyrics）
      // 一併限定本人。
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
